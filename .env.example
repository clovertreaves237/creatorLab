# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# --- Public (safe in the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: shown on /become-a-curator
# NEXT_PUBLIC_CURATOR_APPLY_EMAIL=you@example.com

# --- Server-only secrets ---
GEMINI_API_KEY=your-gemini-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key
# Secret path of the admin portal (more than 7 characters, keep private)
ADMIN_PORTAL_PATH=choose-a-long-random-path

# Invitation emails (Gmail app password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=CreatorLab
